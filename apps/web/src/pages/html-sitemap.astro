---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCaseStudies, getContentPages, getExperts, getProducts, getSiteSettings } from "../lib/content";
import { localeMeta, locales, localizedExtraPages, localizedPath } from "../lib/i18n";
import { catalogGroups, catalogPages } from "../lib/pageCatalog";
import { solutions } from "../lib/solutions";

const settings = await getSiteSettings();
const products = await getProducts();
const cases = await getCaseStudies();
const experts = await getExperts();
const contentPages = await getContentPages();

const coreLinks = [
  { href: "/", title: "Home" },
  { href: "/products", title: "Product category / PLP" },
  { href: "/products/fiber-laser-cutting-machines", title: "Fiber laser machine category" },
  { href: "/request-quote", title: "Get a quote" },
  { href: "/tools/running-cost-calculator", title: "Running cost calculator" },
  { href: "/about", title: "About us" },
  { href: "/html-sitemap", title: "HTML sitemap" }
];
---

<BaseLayout title={`HTML Sitemap | ${settings.brandName}`} description="Human-readable sitemap for the TitanLaser B2B inquiry website demo." pathname="/html-sitemap" siteUrl={settings.siteUrl}>
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">SEO and UX discovery</p>
      <h1>HTML Sitemap</h1>
      <p class="lead">This page proves the demo is a complete preset B2B inquiry site, not a few isolated landing pages.</p>
    </div>
  </section>

  <section class="section band">
    <div class="section-inner sitemap-grid">
      <article class="card">
        <h2>Core pages</h2>
        <ul>{coreLinks.map((link) => <li><a href={link.href}>{link.title}</a></li>)}</ul>
      </article>
      <article class="card">
        <h2>Language versions</h2>
        <ul>
          {locales.map((locale) => <li><a href={`/${locale}`}>{localeMeta[locale].nativeName} home</a></li>)}
          {locales.map((locale) => <li><a href={localizedPath("/products", locale)}>{localeMeta[locale].nativeName} products</a></li>)}
          {locales.map((locale) => <li><a href={localizedPath("/quote-cart", locale)}>{localeMeta[locale].nativeName} RFQ cart</a></li>)}
        </ul>
      </article>
      <article class="card">
        <h2>Products</h2>
        <ul>{products.map((product) => <li><a href={`/products/${product.slug}`}>{product.model}</a></li>)}</ul>
      </article>
      <article class="card">
        <h2>Solutions</h2>
        <ul>{solutions.map((solution) => <li><a href={`/solutions/${solution.slug}`}>{solution.title}</a></li>)}</ul>
      </article>
      <article class="card">
        <h2>Cases and experts</h2>
        <ul>
          {cases.map((item) => <li><a href={`/case-studies/${item.slug}`}>{item.title}</a></li>)}
          {experts.map((item) => <li><a href={`/experts/${item.slug}`}>{item.name}</a></li>)}
        </ul>
      </article>
      <article class="card wide">
        <h2>Guides, clusters, and glossary</h2>
        <ul class="columns">
          {contentPages.map((page) => (
            <li>
              <a href={page.type === "pillar" ? `/guides/${page.slug}` : page.type === "glossary" ? `/glossary/${page.slug}` : `/topics/${page.slug}`}>
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </article>
      {catalogGroups.map((group) => (
        <article class="card wide">
          <h2>{group}</h2>
          <ul class="columns">
            {catalogPages.filter((page) => page.group === group).map((page) => <li><a href={page.path}>#{page.number} {page.title}</a></li>)}
          </ul>
        </article>
      ))}
      <article class="card wide">
        <h2>Localized extra pages</h2>
        <ul class="columns">
          {locales.flatMap((locale) => localizedExtraPages.map((page) => (
            <li><a href={localizedPath(page.path, locale)}>{localeMeta[locale].nativeName}: {page.title}</a></li>
          )))}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .columns {
    columns: 2 280px;
  }

  li {
    margin: 0 0 10px;
    break-inside: avoid;
  }

  a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: none;
  }
</style>
