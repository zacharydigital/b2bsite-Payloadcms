PAYLOAD_SECRET=dev-secret-change-before-production
DB_ADAPTER=sqlite
DATABASE_URI=file:./titanlaser.local.db
PUBLIC_PAYLOAD_URL=http://localhost:3001/api
SITE_URL=http://localhost:4321

# Cloudflare R2 via S3-compatible API. Leave S3_BUCKET empty for local development without uploads.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.yourstudio.com
